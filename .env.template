# OpenRTB Bidder Configuration Template
# Copy this file to .env and update values for your environment

# Server Configuration
PORT=8080
ENABLE_TLS=false  # Set to true for mTLS in production
TLS_CERT_FILE=config/certs/server.crt
TLS_KEY_FILE=config/certs/server.key
TLS_CA_FILE=config/certs/ca.crt

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bidder
DB_USER=bidder
DB_PASSWORD=password
DB_SSLMODE=disable  # Use 'require' in production
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# InfluxDB Metrics
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dev-token-please-change-in-production
INFLUX_ORG=fast-ad-bidder
INFLUX_BUCKET=metrics

# Campaign Management
CAMPAIGN_RELOAD_INTERVAL=60s  # How often to reload campaigns from PostgreSQL
BID_CACHE_TTL=5m             # How long to cache bids for win notification matching

# Logging
LOG_LEVEL=debug              # debug, info, warn, error
LOG_FORMAT=json              # json or console

# Metrics
METRICS_ENABLED=true
PROMETHEUS_NAMESPACE=bidder

# Performance Tuning
MAX_REQUEST_BODY_SIZE=1048576  # 1MB in bytes
REQUEST_TIMEOUT=2s             # Maximum time for request processing
SHUTDOWN_TIMEOUT=30s           # Graceful shutdown timeout
