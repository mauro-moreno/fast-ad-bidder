# Server Configuration
PORT=8080

# PostgreSQL Configuration (connection string format)
# For local development, use: postgres://bidder:bidder_dev_password@localhost:5432/bidder?sslmode=disable
# For production, use: postgres://user:password@host:port/database?sslmode=require
DATABASE_URL=postgres://bidder:bidder_dev_password@localhost:5432/bidder?sslmode=disable

# InfluxDB Configuration (optional - comment out if not using)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=dev-token-change-in-production
INFLUXDB_ORG=fast-ad-bidder
INFLUXDB_BUCKET=metrics

# TLS/mTLS Configuration (set to true to enable mutual TLS authentication)
MTLS_ENABLED=false
TLS_CERT_FILE=config/certs/server.crt
TLS_KEY_FILE=config/certs/server.key
TLS_CA_FILE=config/certs/ca.crt

# Logging (debug, info, warn, error)
LOG_LEVEL=debug

# Win Notification URL (used in bid responses)
WIN_NOTIFICATION_URL=http://localhost:8080/win

# Metrics
METRICS_NAMESPACE=bidder
